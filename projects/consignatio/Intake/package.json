{
  "name": "@casebible/workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "backend:help": "cd backend && .venv\\Scripts\\python.exe -m casebible_index.cli --help",
    "backend:test": "cd backend && .venv\\Scripts\\python.exe -m pytest",
    "backend:lint": "cd backend && .venv\\Scripts\\python.exe -m ruff check .",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "6.0.3",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/react-table": "9.2.4",
    "@tauri-apps/api": "2.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "storybook": "10.5.10",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
