{
  "name": "family-court-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local desktop work surface (Tauri) for the family-court-toolkit plugin — case status, docket, timeline, memos, evidence, evals, reference and a Claude chat pane driven by the Agent SDK against the plugin's embedded SurrealDB case store.",
  "scripts": {
    "design:build": "npm --prefix vendor/propria-design-contract/1.0.0 run build:tokens",
    "design:verify": "npm --prefix vendor/propria-design-contract/1.0.0 run verify",
    "dev": "concurrently -k -n sidecar,vite -c yellow,cyan \"node sidecar/server.mjs\" \"vite\"",
    "dev:sidecar": "node sidecar/server.mjs",
    "build": "vite build && tsc -b",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "lint": "eslint src sidecar .storybook vite.config.ts",
    "test:sidecar": "cross-env CUSTODY_CASE_DB=mem://family-court-console-sidecar-test node --test --test-force-exit --test-timeout=30000 sidecar/tests/*.test.mjs",
    "test:ui": "vitest run",
    "test": "npm run test:sidecar && npm run test:ui"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@fastify/cors": "^10.0.2",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.11",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.563.0",
    "marked": "^15.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-responsive-carousel": "^3.2.23",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/router-plugin": "^1.168.36",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
