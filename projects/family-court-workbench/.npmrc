# Byline: Claude Code · Sonnet 5 · 2026-09-07
#
# @glideapps/glide-data-grid@6.0.3 declares peer ranges (react 16-18.x,
# marked ^4.0.10) that predate this app's specified stack (React 19.2,
# marked 15). The library works fine against newer React/marked in practice
# (verified by this app's own build/test run — see README.md); this is an
# accepted, documented friction point of the owner-specified stack, not a
# real incompatibility we're papering over blind.
legacy-peer-deps=true
