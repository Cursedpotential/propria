{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Family Court Workbench",
  "version": "0.1.0",
  "identifier": "toolkit.familycourt.workbench",
  "build": {
    "beforeDevCommand": "npm run dev:sidecar &",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Family Court Workbench",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
