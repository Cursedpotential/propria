{
  "name": "stirling-pdf-tool",
  "description": "PDF manipulation tool using local Stirling-PDF instance",
  "version": "1.0.0",
  "commands": [
    {
      "name": "stirling",
      "description": "Run Stirling-PDF commands (merge, split, convert)",
      "usage": "stirling <command> [args...]",
      "script": "python \"${extensionPath}/stirling_client.py\""
    }
  ],
  "dependencies": {
    "python": ">=3.8"
  }
}
