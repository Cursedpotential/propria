# Vestigia (TraceIQ) environment. Real values: ~/.secrets/traceiq-db.env (never in git).
# _Byline: Claude Code · Opus 5.5 · 2026-10-02_

# ops/*.py (libpq key=value form), read by ops/db_env.py
TRACEIQ_DSN_KV=host=<tailnet-host> port=5432 dbname=traceiq user=<user> password=<password>

# ui/ (URL form), read by ui/src/lib/db.ts
TRACEIQ_DSN=postgresql://<user>:<password>@<tailnet-host>:5432/traceiq
