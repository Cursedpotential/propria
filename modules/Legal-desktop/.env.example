# Byline: Grok · grok-4.6 · 2026-08-18
# Auth boundary: Codex · GPT-5 · 2026-09-12
# Service names only — never embed tailnet IPs.

LEGAL_WORKSPACE_ENV=dev
LEGAL_API_SERVICE=legal-api
LEGAL_WEB_SERVICE=legal-web
LEGAL_POSTGRES_SERVICE=legal-postgres
EVIDENCE_PLATFORM_SERVICE=evidence-platform
MODEL_GATEWAY_SERVICE=model-gateway

LEGAL_API_PORT=8010
LEGAL_WEB_PORT=3010

# Same PG18 cluster as Agno; isolated schemas + role.
DATABASE_URL=postgresql://legal_os_app:change-me@legal-postgres:5432/ai

# R2 / S3-compatible object prefix for legal work products only.
LEGAL_OBJECT_PREFIX=legal/
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CF_GATEWAY_TOKEN=your_context_forge_gateway_token_here
LEGAL_WORKSPACE_BYPASS_AUTH=false
LEGAL_WORKSPACE_JSON_EXPORT_ENABLED=false

# Public HTTPS human UI: the Coolify Traefik route uses Authentik
# forward-auth and forwards X-authentik-jwt to legal-web. Use the exact values
# from that Authentik application's OIDC provider; do not guess or reuse a
# ContextForge signing secret. Authentik's private signing key stays there.
LEGAL_PUBLIC_HOST=legal.example.invalid
AUTHENTIK_ISSUER=https://auth.example.invalid/application/o/advocatio/
AUTHENTIK_AUDIENCE=replace-with-authentik-client-id
AUTHENTIK_JWKS_URL=https://auth.example.invalid/application/o/advocatio/jwks/
AUTHENTIK_ALLOWED_GROUPS=advocatio-users

# One independent random value, at least 32 bytes, supplied server-side to both
# legal-web and legal-api. It signs only short-lived internal BFF requests.
LEGAL_BFF_SIGNING_SECRET=replace-with-at-least-32-random-bytes
LEGAL_TAILNET_OWNER_ACCESS=true
LEGAL_AUTH_CLOCK_SKEW_SECONDS=30
LEGAL_API_INTERNAL_URL=http://legal-api:8010
LEGAL_WEB_INTERNAL_URL=http://legal-web:3000

# Read-only evidence API. Write path is investigation requests only.
EVIDENCE_PLATFORM_BASE_URL=http://evidence-platform:8000
MODEL_GATEWAY_BASE_URL=http://model-gateway:4000

DISPLAY_TIMEZONE=America/New_York
