# Byline: Grok · grok-4.6 · 2026-08-18
# exiftool added 2026-09-21 (Claude Code · Fable 5.1): metadata for images, video,
# audio, office files and PDFs (CAT5 section E / DOC-10). tesseract-ocr: screenshot
# and photographed-document OCR (DOC-06).
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends libimage-exiftool-perl tesseract-ocr \
    && apt-get clean
WORKDIR /app
COPY pyproject.toml README.md ./
COPY api ./api
COPY sql ./sql
RUN pip install --no-cache-dir .
EXPOSE 8010
CMD ["uvicorn", "legal_workspace.api.main:app", "--host", "0.0.0.0", "--port", "8010"]
