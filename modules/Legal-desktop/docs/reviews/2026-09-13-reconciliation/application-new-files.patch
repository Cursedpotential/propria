+  min-height: var(--pr-control-min-height);
+  padding: 8px 14px;
+  color: var(--pr-action-text);
+  border: 1px solid var(--pr-action);
+  border-radius: var(--pr-radius-control);
+  background: var(--pr-action);
+  font: 700 0.875rem/1 var(--pr-font-ui);
