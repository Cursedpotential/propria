{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/case_law_prompt_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_family-court-toolkit_courtlistener__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/case_law_tool_hook.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__courtlistener__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/case_law_tool_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__plugin_family-court-toolkit_courtlistener__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/case_law_tool_hook.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__courtlistener__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/case_law_tool_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
