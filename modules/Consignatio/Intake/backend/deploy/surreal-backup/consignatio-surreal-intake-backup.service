[Unit]
Description=Authenticated Consignatio Intake SurrealDB export
Requires=docker.service
After=docker.service
ConditionFileIsExecutable=/opt/consignatio/surreal-intake-backup/backup.sh

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/consignatio/surreal-intake-backup/backup.sh
Environment=SURREAL_INTAKE_RETENTION_DAYS=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/consignatio/backups/surreal-intake
ReadWritePaths=/data/consignatio/to_be_deleted/surreal-intake-backups
ReadWritePaths=/run/lock
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
