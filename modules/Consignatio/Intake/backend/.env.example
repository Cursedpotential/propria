# Source bytes are read but never changed. Use a stable source ID so document IDs
# remain portable when the same relative tree moves to another machine.
CASEBIBLE_SOURCE_DIR=./sample_docs
CASEBIBLE_SOURCE_ID=casebible
CASEBIBLE_OUTPUT_DIR=./output

# NVIDIA hosted API. Keep the key in the environment; never commit it here.
NVIDIA_API_KEY=<set-in-windows-credential-manager>
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NIM_SUMMARY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_EMBED_DIMENSIONS=2048

# Text and request sizing. Summaries disclose whether they used full text or
# representative excerpts.
CASEBIBLE_CHUNK_SIZE=2400
CASEBIBLE_CHUNK_OVERLAP=300
CASEBIBLE_SUMMARY_MAX_CHARS=48000
NIM_EMBED_BATCH_SIZE=16
NIM_MAX_CONCURRENCY=4
NIM_TIMEOUT_SECONDS=90
NIM_MAX_RETRIES=4

# Filesystem index resource bounds (not a hard whole-process memory ceiling).
INTAKE_MAX_FILE_BYTES=8388608
INTAKE_MAX_EXTRACTED_CHARS=1000000
INTAKE_MAX_CHUNKS_PER_FILE=512
INTAKE_MAX_INFLIGHT_FILES=2
# Object list source (Claude Code · Opus 5 · 2026-09-18): "filesystem" walks
# CASEBIBLE_SOURCE_DIR; "catalog" lists objects from the Case Bible catalog and reads
# them in place under CASEBIBLE_SOURCE_DIR, which is then the mounted bucket root
# (e.g. /srv/openlist/b2/salem-data). The DSN holds a password: process environment only.
INTAKE_SOURCE_MODE=filesystem
INTAKE_CATALOG_DSN=
# Optional override of the packaged src/casebible_index/sql/catalog_source_current.sql (reads the view
# raw_duck.superindex_source_current, casebible/tools/superindex_source_current_20261003.sql).
INTAKE_CATALOG_QUERY_FILE=
# Required for V:/Y: alias indexing; inspect example before enabling.
INTAKE_SOURCE_REGISTRY=
# Optional override; all workers sharing a source must share this local lock directory.
# Default: this backend's output/.source-locks (E:), independent of per-run output.
INTAKE_LOCK_DIR=

# Opt-in derived Weaviate target. Provision a dedicated schema before enabling.
# Blank origin/collection fail closed; no remote is guessed and no schema auto-created.
INTAKE_WEAVIATE_INDEX_ENABLED=0
INTAKE_WEAVIATE_URL=
INTAKE_WEAVIATE_COLLECTION=
INTAKE_WEAVIATE_TEXT_VECTOR=text_nim
INTAKE_WEAVIATE_API_KEY=<set-in-windows-credential-manager>
INTAKE_WEAVIATE_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Dedicated Intake graph, reachable over the tailnet.
INTAKE_SURREAL_URL=https://surreal-intake.tilapia-skilift.ts.net
# Namespace/database and runtime user are fixed by the backend.
# Windows password: Generic Credential INTAKE_SURREAL_PASSWORD.propria-intake-dev,
# username INTAKE_SURREAL_PASSWORD, UTF-16LE blob. Never put it in this file.

# --- Automatic cycle (Claude Code · Sonnet 5.5 · 2026-10-02); see docs/runbooks/superindex-automatic-cycle.md ---
# provider:bucket entries to index (default: the primary vault bucket only).
INTAKE_SOURCE_BUCKETS=b2:salem-data
# chunk = message exports become conversation chunks; route = a document row only.
INTAKE_CONVERSATION_MODE=chunk
# route = AI chat exports (conversations.json) are represented, never chunked; index = old behaviour.
INTAKE_AI_CHAT_MODE=route
INTAKE_CHUNKER=
INTAKE_CHUNK_OVERLAP_MESSAGES=0
INTAKE_SPOOL_DIR=
INTAKE_INDEX_ARCHIVE_MEMBERS=1
INTAKE_ARCHIVE_MEMBER_LIMIT=0
# Named vector slots; `legal` also needs INTAKE_VECTOR_LEGAL_MODEL (+ _DIMENSIONS, _BASE_URL, _KEY_SECRET, _STYLE).
INTAKE_VECTOR_SLOTS=text_nim
INTAKE_CHUNK_COLLECTION=CaseBibleChunks20261002
# Worker limits and cadence.
INTAKE_EXTRACT_RSS_LIMIT_MB=3000
INTAKE_EXTRACT_TIME_BUDGET_S=0
INTAKE_GRAPH_MIN_INTERVAL_HOURS=24
INTAKE_SUMMARY_STAGE=on
INTAKE_SUMMARY_MIN_CHARS=800
INTAKE_SUMMARY_MAX_DOCS_PER_PASS=200
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=superindex


# Image stage (OFF by default). See docs/runbooks/superindex-automatic-cycle.md, "Image stage".
INTAKE_IMAGE_STAGE=off
INTAKE_IMAGES_WEAVIATE_URL=
INTAKE_IMAGES_COLLECTION=IntakeImageV1
INTAKE_IMAGES_SLOTS=image_maxsim,image_single
INTAKE_IMAGES_SINGLE_PROVIDER=nim
INTAKE_IMAGES_MAXSIM=all
INTAKE_IMAGES_COLQWEN=screenshots
INTAKE_IMAGES_COLQWEN_URL=
INTAKE_IMAGES_CLIP=0
INTAKE_IMAGES_PHOTO_TIER=all
INTAKE_IMAGES_OCR_ENGINE=tesseract
