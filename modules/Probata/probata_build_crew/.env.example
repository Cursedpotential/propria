# Byline: Claude Code · Fable 5.1 · 2026-09-06 — copy to .env (literal values or ${VAR} refs; python-dotenv expands them)
# Primary LLM: Ollama Cloud nemotron-3-super via CrewAI's native 'ollama' provider (llm_chain/chains.py)
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
# Fallback chain: OpenRouter FREE models only (:free ids), see llm_chain/chains.py
OPENROUTER_API_KEY=
# Optional overrides
# CREW_PRIMARY_LLM=ollama/nemotron-3-super
# CREW_MAX_TOKENS=16000
# CREW_CONTEXT_WINDOW=200000
# Read-only file tools must reach the probata tree outside this directory
CREWAI_TOOLS_ALLOW_UNSAFE_PATHS=true
PROBATA_REPO_ROOT=E:/AI_Workspace/Projects/the-platform-workspace/probata
SMART_EXPLORE_DIR=C:/Users/matts/.agents/skills/smart-explore
