# Force LF on shell scripts and text the container executes — Windows authoring
# must never reintroduce CRLF (breaks `#!/bin/bash` shebangs in Linux containers).
*.sh    text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
Dockerfile text eol=lf
*.env   text eol=lf
* text=auto

# Normalize additional source/text formats to LF in the repository.
*.go    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf

# Vendored //go:embed assets — byte-exact, never line-ending-normalized. These
# are upstream build artifacts embedded by
# github.com/tailscale/web-client-prebuilt; a CRLF rewrite would silently alter
# what the binary serves and would show as churn against `go mod vendor`.
modules/engine/vendor/github.com/tailscale/web-client-prebuilt/build/** -text

# Binary formats — never diff or normalize.
*.png    binary
*.jpg    binary
*.zip    binary
*.duckdb binary
*.pdf    binary

# Added 2026-09-26 before the repository-wide renormalisation. This nested file
# overrides the root .gitattributes for everything under Probata, so the root's
# binary list does not reach these paths — they must be repeated here or a
# renormalisation pass treats them as text and corrupts them.
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.node   binary
*.wasm   binary
*.pyc    binary
*.ico    binary
*.gz     binary
*.7z     binary
*.mp4    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.jar    binary
*.sqlite binary
*.gif    binary
*.jpeg   binary
*.webp   binary
*.parquet binary
*.lance  binary
*.class  binary
*.bin    binary
