{
  "mcpServers": {
    "propria-search": {
      "command": "uv",
      "args": ["run", "--project", "${CLAUDE_PLUGIN_ROOT}", "--quiet", "python", "${CLAUDE_PLUGIN_ROOT}/mcp_server.py"],
      "env": {
        "PROPRIA_SEARCH_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/env",
        "PYTHONUTF8": "1"
      }
    }
  }
}
