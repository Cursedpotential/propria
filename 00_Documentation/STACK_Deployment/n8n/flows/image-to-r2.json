{
  "nodes": [
    {
      "parameters": {
        "path": "/srv/new_uploads",
        "recursive": true
      },
      "id": "WatchFile",
      "name": "Watch File",
      "type": "n8n-nodes-base.watchFilesystem"
    },
    {
      "parameters": {
        "operation": "upload",
        "bucket": "screenshots",
        "fileName": "={{$json.filename}}",
        "fileContent": "={{$json.content}}"
      },
      "id": "UploadR2",
      "name": "Upload to R2",
      "type": "custom-s3-upload-node"
    },
    {
      "parameters": {
        "functionCode": "return [{ json: { message: \"Trigger Rekognition (placeholder)\" } }];"
      },
      "id": "RekognitionStub",
      "name": "Trigger Rekognition",
      "type": "n8n-nodes-base.function"
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "images",
        "data": {
          "filename": "={{$json.filename}}",
          "r2_url": "={{$json.r2_url}}",
          "notes": "",
          "created_at": "={{$now}}"
        }
      },
      "id": "SaveToSupabase",
      "name": "Save to Supabase",
      "type": "custom-supabase-node"
    }
  ],
  "connections": {
    "WatchFile": {
      "main": [["UploadR2"]]
    },
    "UploadR2": {
      "main": [["RekognitionStub"]]
    },
    "RekognitionStub": {
      "main": [["SaveToSupabase"]]
    }
  }
}
