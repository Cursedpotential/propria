# ===========================================
# SALEM PROCESSING STACK - ENVIRONMENT VARIABLES
# Copy to .env and fill in values
# ===========================================

# ===========================================
# SUPABASE (PostgreSQL)
# ===========================================
# Pooler URL (for most services)
SUPABASE_DB_URL=postgresql://postgres.oflqpddqaecotsdsxbzp:PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Direct connection (for Directus - requires IPv6)
SUPABASE_HOST=db.oflqpddqaecotsdsxbzp.supabase.co
SUPABASE_USER=postgres
SUPABASE_PASSWORD=

# API access
SUPABASE_URL=https://oflqpddqaecotsdsxbzp.supabase.co
SUPABASE_KEY=eyJ...

# ===========================================
# NEO4J AURA (Knowledge Graph)
# ===========================================
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ===========================================
# QDRANT CLOUD (Vector Search)
# ===========================================
QDRANT_URL=https://xxxxx.qdrant.io:6333
QDRANT_API_KEY=

# ===========================================
# CLOUDFLARE R2 (File Storage)
# ===========================================
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=salem-legal-evidence

# ===========================================
# LLM API KEYS
# ===========================================
OPENAI_API_KEY=sk-
ANTHROPIC_API_KEY=sk-ant-
OPENROUTER_API_KEY=sk-or-

# ===========================================
# LITELLM (LLM Gateway)
# ===========================================
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=

# ===========================================
# MEM0 (AI Memory)
# ===========================================
MEM0_API_KEY=

# ===========================================
# DIRECTUS (Admin UI)
# ===========================================
# Generate with: uuidgen
DIRECTUS_KEY=
# Generate with: openssl rand -hex 32
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=matt@mitechconsult.com
DIRECTUS_ADMIN_PASSWORD=

# ===========================================
# CHAT UIs
# ===========================================
# Open WebUI - generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# LobeChat
LOBECHAT_ACCESS_CODE=

# ===========================================
# BROWSERLESS
# ===========================================
# Generate with: openssl rand -hex 16
BROWSERLESS_TOKEN=

# ===========================================
# OPTIONAL / LEGACY
# ===========================================
# ACME_EMAIL=matt@mitechconsult.com  # Only if using Traefik directly
