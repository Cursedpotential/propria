# =========================
# Propria monorepo root ignore policy
# Product routes use modules/; shared root tools use scripts/ and plugins/.
# =========================

# =========================
# Python (global)
# =========================
__pycache__/
*.py[codz]
*$py.class
*.pyc

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/
.cache

# Package-manager lockfiles are source and should be committed by their projects.

# =========================
# Virtual envs + secrets
# =========================
.venv/
venv/
env/
ENV/
.env
.env.local
.env.production
.env.*.local
.envrc

# =========================
# Jupyter / notebooks
# =========================
.ipynb_checkpoints/

# =========================
# IDEs / editors
# =========================
.idea/
.vscode/
*.swp
*.swo
*~

# =========================
# OS cruft
# =========================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# Project-specific: dev-resources archives & parts bins (READ-ONLY REFERENCE)
# =========================
# All of dev-resources/ is read-only reference material from old repos
# Never track, build on, or commit anything from here
dev-resources/

# Parts bin alpha codebase (reference only)
Agno-MCP-Platform-agno - alpha/

# =========================
# Project-specific: Agno-MCP-Platform (active build)
# =========================
# Database / data files
*.db
*.sqlite
*.sqlite3
*.duckdb

# Local data directories
probata/data/
Agno-MCP-Platform/data/
probata/tmp/
Agno-MCP-Platform/tmp/
probata/.data/
Agno-MCP-Platform/.data/

# Agno/osgrep/memsearch caches
Agno-MCP-Platform/.osgrep/
Agno-MCP-Platform/.memsearch/
Agno-MCP-Platform/.remember/

# Local Claude Code config
Agno-MCP-Platform/.claude/

# =========================
# Build / CI artifacts
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Docker
# =========================
.docker/

# =========================
# Checksum files (thousands of noise files)
# =========================
*.xxh3

# =========================
# Temporary / generated files
# =========================
*.tmp
*.temp
tmp/
temp/
*.bak
*.backup

# =========================
# OS-specific
# =========================
# Windows
$RECYCLE.BIN/
System Volume Information/

# Linux/macOS
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =========================
# Editor temp files
# =========================
*.sublime-workspace
*.sublime-project
.vs/
*.code-workspace

# =========================
# Language-specific (optional per subdir)
# =========================
# Node (if any sub-project uses it)
node_modules/
npm-debug.log*
.yarn/
.pnp
.pnp.js

# Rust (if any)
target/

# Go (if any)
vendor/
# Except the Go engine: its images build with `go build -mod=vendor`
# (deploy/docker/tool-gateway/Dockerfile), so its vendor tree must be in git. The blanket
# rule above silently dropped new dependencies while the 4,659 already-tracked files kept
# working. Claude Code · Opus 5.5 · 2026-09-28.
!modules/Probata/probata/modules/engine/vendor/
# Recall plugin auto-generated context
.claude/recall-context.md

# Local infrastructure secrets / access (NEVER commit, NEVER ingest)
Secrets/
.Secrets/

# Machine-local agent and indexing state
/.runtime/
/.claude/
/.cnf/
/.memory/
/.memsearch/
/.remember/
/.reconciliation/
/_db-snapshots/
/_worktrees/
/cc_index.log
/cc_index.mjs
/cc_probe.mjs

# Owner-controlled quarantine is preserved locally and never versioned.
**/to_be_deleted/
**/COMPACT-SUMMARY-*.md

# Runtime authorization and local state are never source artifacts.

# Local databases, scan projects, patches, and one-off audit exports at the root
/*.ssdb
/*.dupeguru
/*.patch
/*.sql
/_changed_lines.txt
/_owner-turns-*.csv

# Pre-monorepo root artifacts awaiting explicit classification. They are
# preserved in place and listed by the migration inventory; ignore is not deletion.
/*.html
/COMPACT-SUMMARY-*.md
/docs/COMPACT-SUMMARY-*.md
/DOC_PATCH_REPORT-*.md
/NAMING.md.lnk

# Transitional source repositories. Remove each fence only through its verified
# import step in docs/monorepo-migration-manifest.json.
/Consignatio/
/Probata/
/FL-MCP/
/Legal-desktop/
/design-contract/

# The canonical design token source is repository content. This explicit
# inclusion overrides the user-level `*token*.json` rule; generated tokens.css
# remains derived from this tracked file.
!/design-contract/tokens.json

# Docstore root links (2026-09-19, owner): Propria/docs is the one Docstore root; these are
# Windows junctions into each module's own docs folder, which that module's repo tracks.
/docs/probata
/docs/consignatio
/docs/consignatio-intake
/docs/advocatio
/docs/vestigia
/docs/family-court

# Independent repositories relocated under modules; retain their own histories.

# Local Docstore databases and credential backups are never source.
/docs/.docstore/
# Preserve only the tracked placeholder in plugin runtime state.
/plugins/docstore/claude/.state/*
!/plugins/docstore/claude/.state/.gitkeep

# Evidence corpora and location data: kept on disk, never committed to the monorepo.
/modules/vestigia-geodata_processor/raw_api_responses/
/modules/vestigia-geodata_processor/TraceIQ_Main/
/modules/vestigia-geodata_processor/TraceIQ_Backups/
/modules/vestigia-geodata_processor/TraceIQ_Evidence/
/modules/vestigia-geodata_processor/traaceiq_mess/
/modules/vestigia-geodata_processor/Timeline.json
/modules/Consignatio/_intake/
/modules/Consignatio/casebible/vault-sorted.7z
# Review holding area: large or sensitive material awaiting the owner, never tracked (2026-09-26).
/.review_hold/
